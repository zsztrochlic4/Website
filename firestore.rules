rules_version = '2';

// Security rules for the website's contact form.
// Visitors may CREATE a submission; nobody can read, update or delete via the
// client. Read your submissions in the Firebase console (Firestore Database) or
// with the Admin SDK / service account.
service cloud.firestore {
  match /databases/{database}/documents {

    match /contact_submissions/{submissionId} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['full_name', 'email', 'phone', 'goals', 'created_at']
        )
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() > 0
        && request.resource.data.full_name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 100
        && request.resource.data.goals is string
        && request.resource.data.goals.size() < 5000;

      allow read, update, delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
