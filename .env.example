# Supabase credentials used by the contact form (src/lib/supabase.ts).
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). The site builds and runs without them; the contact
# form simply reports that it is not configured until they are set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
