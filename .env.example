# Firebase web app config used by the contact form (src/lib/firebase.ts).
# Copy this file to `.env` and paste the values from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> "SDK setup and config".
# These are not secrets (they ship in the client bundle); access is controlled
# by firestore.rules. The site builds and runs without them; the contact form
# just reports that it is not configured until they are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
